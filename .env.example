# Copy to .env and adjust. Single source of server env (mirip fullstack):
# apps/api + worker dimuat via `pnpm with-env` (dotenv -e ../../.env).
# apps/platform tetap baca apps/platform/.env sendiri khusus vars VITE_*.

# Application
PORT=8377
NODE_ENV=development
# CORS: origin frontend yang boleh panggil gateway dari browser.
# Bisa lebih dari satu, pisahkan koma (tanpa spasi).
PLATFORM_URL=http://127.0.0.1:8378,http://localhost:8378
MAX_UPLOAD_MB=30
PUBLIC_BASE_URL=http://127.0.0.1:8377

# Local conversion artifacts. API and worker must use the same directory.
# Relative paths resolve from apps/api; default: apps/api/data/public.
# ARTIFACT_DIR=./data/public
ARTIFACT_MAX_MB=1024
# Delete artifacts whose expires_at has passed.
INDEX_SWEEP_MINUTES=5

# Converter (sibling repo pdf-md-conversion-service-py, :8379).
# Used only for conversion requests and async-job polling. Stored results,
# document listing, downloads, and /public files are served locally by apps/api.
CONVERTER_URL=http://127.0.0.1:8379
CONVERTER_API_KEY=
# Upper bound for a proxied conversion (ms). Large PDFs take minutes on the
# single-worker converter; sync requests exceeding this get HTTP 504 while
# async jobs (POST /convert/jobs) keep running server-side.
CONVERT_TIMEOUT_MS=600000

# RAG (agent + worker). Gateway tetap serve /convert tanpa ini,
# tapi indexing/chat return 503 sampai diisi.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15433/postgres
REDIS_URL=redis://127.0.0.1:16379
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=document
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# CHAT_HISTORY_TURNS=6
# Max agent turns (model/tool loop) per chat request. Default 5.
# CHAT_MAX_TURNS=5
# EMBEDDING_DIMS=384
